# ─── WhatsApp ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=5531999990000
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Gostaria de mais informações sobre os produtos da Líder Molduras.

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Líder Molduras
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br
NEXT_PUBLIC_EMAIL=atendimento@seu-dominio.com.br

# ─── Formulário — Opção A: Resend (recomendado, 3k e-mails/mês grátis) ─────────
# 1. Crie conta em resend.com  2. Gere API key  3. Verifique seu domínio
# 4. Descomente o bloco Resend em app/api/contato/route.ts
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_EMAIL=atendimento@seu-dominio.com.br

# ─── Formulário — Opção B: Netlify Forms (100 envios/mês grátis) ───────────────
# Sem variáveis. Use ContactFormNetlify.tsx. Netlify detecta data-netlify="true".

# ─── Formulário — Opção C: Formspree (50 envios/mês grátis) ───────────────────
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# ─── Google Analytics (opcional) ──────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── CMS – Sanity (migração futura) ───────────────────────────────────────────
# IMPORTANTE: apiVersion deve ser a data atual da implementação (formato YYYY-MM-DD)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2025-05-12
# SANITY_API_TOKEN=

# ─── CMS – Contentful (alternativa ao Sanity) ─────────────────────────────────
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=
# CONTENTFUL_PREVIEW_TOKEN=

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Crie o projeto em supabase.com, vá em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key — usar APENAS em API routes server-side, NUNCA expor no cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Painel Admin ──────────────────────────────────────────────────────────────
# E-mail do usuário admin (deve ser criado no painel Supabase > Authentication > Users)
ADMIN_EMAIL=admin@lidermolduras.com.br
